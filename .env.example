# Copy this file to .env and fill in your values
# .env is excluded from git — never commit real keys

# Port to run the local server on
PORT=3000

# Your Telnyx API V2 Key (Mission Control Portal → API Keys)
TELNYX_API_KEY=your_telnyx_api_key_here

# Your Telnyx WebRTC Credential Connection ID (Connections → Credential Connection ID)
TELNYX_CREDENTIAL_ID=your_telnyx_credential_id_here

# Your verified outbound phone number in E.164 format (e.g. +12125551234)
TELNYX_VERIFIED_NUMBER=+1xxxxxxxxxx
